# Environment variables read by application-prod.yml (SPRING_PROFILES_ACTIVE=prod).
# Template only - never put real values in a file that gets committed.
#
# For local development, copy application-local.yml.example to
# application-local.yml instead and fill in the values there; the local
# profile reads straight from that file rather than the environment.

SPRING_PROFILES_ACTIVE=prod

# Supabase -> Project Settings -> Database -> Connection string -> JDBC.
# The app's own pool uses the transaction pooler (port 6543); Flyway needs
# the session pooler (5432) for its advisory lock.
#
# gssEncMode=disable matters on some hosts (Render included): pgjdbc's GSS
# encryption negotiation step gets the connection dropped mid-handshake by
# Supabase's pooler in certain container environments, even though the same
# URL works fine from a local machine.
SUPABASE_DB_URL=jdbc:postgresql://<region>.pooler.supabase.com:6543/postgres?sslmode=require&gssEncMode=disable
SUPABASE_MIGRATION_URL=jdbc:postgresql://<region>.pooler.supabase.com:5432/postgres?sslmode=require&gssEncMode=disable
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<paste-your-database-password>

# Supabase -> Project Settings -> API. Drives the JWT issuer check.
SUPABASE_URL=https://<project-ref>.supabase.co

# collegefootballdata.com/key
CFB_DATA_API_KEY=<paste-your-cfbd-key>

# Deployed frontend origin(s), comma-separated.
ALLOWED_ORIGINS=https://your-frontend.example.com

# Accounts promoted to ADMIN automatically on first sign-in.
ADMIN_EMAILS=you@example.com
